# AeroDefense responder — the second container in docker-compose.yml.
#
# Copy to `.env.aerodefense` on the droplet and fill in the blanks. The
# Mindaptive `.env` is untouched; these two files never share state.
#
#   cp .env.aerodefense.example .env.aerodefense

# --- What makes this container AeroDefense -----------------------------------

# Prompt, knowledge base, personas.json and signatures come from here.
CLIENT_DIR=clients/aerodefense
CLIENT_LABEL=AeroDefense

# AeroDefense's own Smartlead account. This is the whole responder: campaigns,
# leads, categories, message history and sends all use this key.
SMARTLEAD_API_KEY=
SMARTLEAD_ACCOUNT_LABEL=AeroDefense

# Separate database and upload dir. docker-compose mounts ./data-aerodefense
# at /data for this container, so these paths stay the same as Mindaptive's
# while pointing at a different volume on the host.
DB_PATH=/data/responder.db
UPLOAD_DIR=/data/uploads

# --- Model ---------------------------------------------------------------

# The replies are template-driven, so the model is filling in and lightly
# personalising approved copy rather than composing from scratch. Haiku handles
# that at a fraction of the cost. (Haiku works fine with web search here —
# app/drafter.py sets allowed_callers=["direct"], which is what it needs.)
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TRANSLATE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- Auth --------------------------------------------------------------------

APP_PASSWORD=
SECRET_KEY=change-me-to-a-different-random-string-than-mindaptive

# Public URL of THIS instance — used for dashboard links in notifications and
# for the images embedded in drafts, which the recipient's mail client fetches
# from it. Must be the real externally reachable hostname.
PUBLIC_BASE_URL=https://aero.yourdomain.com

# --- Webhook -----------------------------------------------------------------

# Register <PUBLIC_BASE_URL>/webhooks/smartlead in AeroDefense's Smartlead
# account and set the same secret here. Blank skips verification.
SMARTLEAD_WEBHOOK_SECRET=

# Slack notification for a lead reply. Leave blank for none. NOTE: this is where
# *this app POSTs to*, which is not the same thing as the n8n webhook Smartlead
# posts into — different direction, different payload.
N8N_WEBHOOK_URL=

# --- Google Sheets: the "Export for LinkedIn" button -------------------------

# Same OAuth client as the Mindaptive instance ("n8n-app") — one app, two
# containers. The redirect URI is per-instance though, so the client's
# "Authorized redirect URIs" must also list this hostname's:
#   https://aero.mindaptive.ai/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This container has its own database, so it would otherwise need its own
# "Connect Google Sheets" click. Paste the refresh token the Mindaptive
# instance already obtained here to skip that (read it from its database:
# select value from app_settings where key='google_refresh_token').
GOOGLE_REFRESH_TOKEN=
# AeroDefense's own sheet — tabs Max / Amy / Andrew / Other.
LINKEDIN_SHEET_ID=1wEtKuOUGK75oc2AC6jx2eVsfLMEoqWV7m1o8f9LOTKI
# Where threads from the retired anna@/linda@/lexi.r@ mailboxes land.
LINKEDIN_SHEET_FALLBACK_TAB=Other

# --- Follow-up policy --------------------------------------------------------

# Verified against the live account: "Interested" exists as category id 1.
INTERESTED_CATEGORY_NAME=Interested
AUTOREPLY_CATEGORY_NAME=Auto-Reply
MEETING_BOOKED_CATEGORY_NAME=Meeting-Booked

FOLLOWUP_WAIT_DAYS=3,4,6,8
MAX_FOLLOWUPS=4
REVIVE_AFTER_DAYS=60

# Offset from Mindaptive's scan hour so the two containers don't hammer
# Anthropic and Smartlead at the same minute.
DAILY_SCAN_HOUR_UTC=7
SCAN_INTERVAL_MINUTES=5

SMARTLEAD_REQUESTS_PER_MINUTE=50
SMARTLEAD_BURST_PER_SECOND=8
SMARTLEAD_CATEGORY_CACHE_SECONDS=600

# --- Safety ------------------------------------------------------------------

# Leave DRY_RUN on until you have reviewed a few real drafts.
DRY_RUN=true
AUTO_SEND_FOLLOWUPS=false
AUTO_GENERATE_FOLLOWUPS=true

# Unused by AeroDefense (its booking links live per-persona in
# clients/aerodefense/personas.json), kept only so config.py has a value.
CALENDLY_LINK=
REQUIRE_KNOWN_SENDER=true

# Every AeroDefense prospect writes English, so skip per-lead language
# detection. That is one Claude call per lead during the scan; off, the scan
# needs no model at all and keeps working even if the Anthropic account has a
# problem.
DETECT_LANGUAGE=false
