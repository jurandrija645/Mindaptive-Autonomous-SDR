# Smartlead — the main (Mindaptive) account. Powers the whole responder app and
# is the default account in the Campaigns analysis tab.
SMARTLEAD_API_KEY=
# Optional label for that account shown in the Campaigns account switcher.
SMARTLEAD_ACCOUNT_LABEL=Mindaptive

# Additional Smartlead accounts for the Campaigns analysis tab (read-only). Any
# `<NAME>_SMARTLEAD_API_KEY` adds an account: slug <name> lowercased, label
# <name> title-cased. Just add the line and restart — no code change. This one
# is also used by scripts/client_export.py.
AERODEFENSE_SMARTLEAD_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Fallback default drafting model. The dashboard's "☆ Set as default" button
# overrides this (stored in the DB), so this only applies until one is set.
ANTHROPIC_MODEL=claude-sonnet-5
# Cheap model used only for on-demand thread translation (not draft writing).
# Always Anthropic — never an OpenRouter id.
ANTHROPIC_TRANSLATE_MODEL=claude-haiku-4-5

# OpenRouter — optional second provider in the model picker (DeepSeek, Gemini,
# GPT, Grok, Qwen...). Leave blank and the picker stays Anthropic-only; set it
# and every model in models_registry.CURATED_OPENROUTER_MODELS becomes
# selectable, with live prices from OpenRouter's /models endpoint. OpenRouter
# drafts have no web research and no prompt caching — see app/openrouter.py.
OPENROUTER_API_KEY=
# Extra OpenRouter model ids to offer, comma-separated — try a model without a
# code change (e.g. "mistralai/mistral-medium-3-5,qwen/qwen3.7-max")
OPENROUTER_MODELS=

# Dashboard auth (single shared password) + session signing key
APP_PASSWORD=
SECRET_KEY=change-me-to-a-random-string

# n8n webhook URL that posts the "lead replied" Slack notification
N8N_WEBHOOK_URL=

# Shared secret Smartlead sends back on webhook calls (set the same value when
# registering the webhook in Smartlead); leave blank to skip verification
SMARTLEAD_WEBHOOK_SECRET=

# Public URL this app is reachable at (used to build dashboard links in Slack notifications)
PUBLIC_BASE_URL=https://sdr.yourdomain.com

# Cloudflare Tunnel token (docker-compose reads this for the cloudflared service)
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Google Sheets: the "Export for LinkedIn" button on a lead ----
# OAuth client from Google Cloud Console — the "n8n-app" Web application client
# in project n8n-mindaptive. Its "Authorized redirect URIs" must list every host
# this app runs on, because the callback URL is derived from PUBLIC_BASE_URL:
#   https://sdr.mindaptive.ai/oauth/google/callback     (this instance)
#   https://aero.mindaptive.ai/oauth/google/callback    (AeroDefense)
#   http://localhost:8080/oauth/google/callback         (local dev)
# The Google Sheets API also has to be enabled on that project.
# Blank = the export button is not shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Normally left blank: the refresh token is obtained by clicking
# "Connect Google Sheets" in the dashboard and stored in the database. Set it
# only to share one consent across containers, which have separate databases.
GOOGLE_REFRESH_TOKEN=
# Spreadsheet leads are exported into, one tab per sending persona. Take the id
# out of its URL: docs.google.com/spreadsheets/d/<THIS>/edit
LINKEDIN_SHEET_ID=
# Tab for a lead whose thread came from a mailbox that no longer maps to a
# persona. Created (with a header row) if the spreadsheet doesn't have it.
LINKEDIN_SHEET_FALLBACK_TAB=Other

# Optional second sheet (app/interested_sheet.py): every lead that clears
# reply_classifier as INTERESTED gets a row automatically, no click required —
# unlike the LinkedIn sheet above, which is manual and per-lead. Blank (the
# default) means this is entirely off. Reuses the same Google OAuth
# connection, so no separate "Connect" step. Take the id out of the sheet's
# URL the same way as LINKEDIN_SHEET_ID.
INTERESTED_SHEET_ID=

# Shared secret for POST /webhooks/booking-confirmed — lets an external
# automation (e.g. an n8n flow watching a booking-confirmation mailbox) record
# a meeting booked outside Smartlead's own category flow, by posting the
# booked person's email. Same convention as SMARTLEAD_WEBHOOK_SECRET: send it
# as the `x-webhook-secret` header or a `?secret=` query param. Blank disables
# the check — fine for local testing, set it before this is public.
BOOKING_WEBHOOK_SECRET=

# Where the SQLite DB lives inside the container (matches the docker-compose volume)
DB_PATH=/data/responder.db

# Images pasted/dropped into a draft are stored here and served publicly at
# PUBLIC_BASE_URL/i/<name> (same volume as the DB, so they survive a redeploy).
# PUBLIC_BASE_URL must be the real, externally reachable URL — the recipient's
# mail client fetches the image from it.
UPLOAD_DIR=/data/uploads

# Safety switches
DRY_RUN=true
AUTO_SEND_FOLLOWUPS=false
# Pre-generate every due follow-up draft right after the daily scan via the
# Anthropic Batch API (50% token cost, results within ~1h) so the morning
# dashboard is a ready review queue. Generation only — sending still requires
# a click unless AUTO_SEND_FOLLOWUPS is also on.
AUTO_GENERATE_FOLLOWUPS=true

# Follow-up policy
INTERESTED_CATEGORY_NAME=Interested
# Smartlead auto-classifies auto-reply/out-of-office bounces under this category;
# leads here get a short "please forward this" nudge instead of the normal pipeline
AUTOREPLY_CATEGORY_NAME=Auto-Reply
# Smartlead category that marks a booked meeting — freezes all outreach for the
# lead and feeds the Stats view (matched ignoring case/punctuation)
MEETING_BOOKED_CATEGORY_NAME=Meeting-Booked
# Days before follow-up #1, #2, ... — a comma list spaces touches out as the
# thread goes colder (last value repeats); a single number keeps a fixed cadence
FOLLOWUP_WAIT_DAYS=3,4,6,8
# HOURS to wait before chasing a lead rated 🔥 very hot — one who asked to meet,
# call or see a demo. Only ever shortens the wait above, never lengthens it.
# Hot leads also sort to the very top of the inbox, which this doesn't affect;
# 0 just puts them back on the day cadence. See app/lead_temperature.py.
HOT_FOLLOWUP_WAIT_HOURS=24
MAX_FOLLOWUPS=4
# After the cap, quietly resurface a cold lead for one revival touch every N
# days of silence (0 disables)
REVIVE_AFTER_DAYS=60
DAILY_SCAN_HOUR_UTC=6
# How often (minutes) to run the lightweight reply-catch scan: the safety net
# for replies the webhook missed (it's fire-and-forget and drops during a deploy
# restart), so you never have to click "Rescan now" to see a reply. Cheap — it
# only re-checks leads already in an active conversation and bulk-fetches their
# threads (~one API call per campaign), so it stays far under the rate limit. No
# extra Claude cost (a reply is still drafted only once). 0 disables.
SCAN_INTERVAL_MINUTES=5

# How often to ask Smartlead "who has written to us lately?" — one call to the
# unified inbox across every campaign, so a lead's FIRST reply shows up without
# waiting for Smartlead's own AI to categorise them as Interested (which is what
# the daily scan filters on, and what used to make a first reply invisible for
# hours — see docs/reply-visibility-log.md). Two API calls, no per-lead work.
# 0 disables.
NEW_REPLY_POLL_SECONDS=60

# Model that sorts an incoming reply into "real prospect" vs "out of office /
# rejection", deciding whether to spend a draft on it — never whether you see
# it. Cheapest model in the picker by default; also settable at runtime in the
# dashboard's Models panel ("Sorting incoming replies").
REPLY_CLASSIFIER_MODEL=deepseek/deepseek-v4-flash

CALENDLY_LINK=https://calendly.com/andrew-mindaptive/30min
