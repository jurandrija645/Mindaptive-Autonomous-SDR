# OneBodyLDN responder — a third container in docker-compose.yml.
#
# Copy to `.env.onebodyldn` on the droplet and fill in the blanks. The
# Mindaptive `.env` and `.env.aerodefense` are untouched; all three files
# never share state.
#
#   cp .env.onebodyldn.example .env.onebodyldn

# --- What makes this container OneBodyLDN ------------------------------------

# Prompt, knowledge base, personas.json and signatures come from here.
CLIENT_DIR=clients/onebodyldn
CLIENT_LABEL=OneBodyLDN

# OneBodyLDN's own Smartlead account. This is the whole responder: campaigns,
# leads, categories, message history and sends all use this key.
SMARTLEAD_API_KEY=
SMARTLEAD_ACCOUNT_LABEL=OneBodyLDN

# Separate database and upload dir. docker-compose mounts ./data-onebodyldn
# at /data for this container, so these paths stay the same as Mindaptive's
# while pointing at a different volume on the host.
DB_PATH=/data/responder.db
UPLOAD_DIR=/data/uploads

# --- Model ---------------------------------------------------------------

# Replies are template-driven for the common cases (yes/insurance/pricing/
# not-interested — see clients/onebodyldn/knowledge/response-templates.md)
# with freeform fallback from the knowledge base for anything else. Haiku
# handles that fine at a fraction of the cost.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TRANSLATE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# --- Auth --------------------------------------------------------------------

APP_PASSWORD=
SECRET_KEY=change-me-to-a-different-random-string-than-mindaptive-and-aerodefense

# Public URL of THIS instance — used for dashboard links in notifications and
# for the images embedded in drafts, which the recipient's mail client fetches
# from it. Must be the real externally reachable hostname.
PUBLIC_BASE_URL=https://onebody.yourdomain.com

# --- Webhook -----------------------------------------------------------------

# Register <PUBLIC_BASE_URL>/webhooks/smartlead in OneBodyLDN's Smartlead
# account and set the same secret here. Blank skips verification.
SMARTLEAD_WEBHOOK_SECRET=

# Slack notification for a lead reply. Leave blank for none.
N8N_WEBHOOK_URL=

# --- Google Sheets: the "Export for LinkedIn" button -------------------------

# Blank = the export button is not shown. Fill in only if/when OneBodyLDN
# gets its own tracking sheet — not needed to run the responder itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
LINKEDIN_SHEET_ID=
LINKEDIN_SHEET_FALLBACK_TAB=Other

# --- Follow-up policy --------------------------------------------------------

# Confirm these against the live Smartlead account before relying on them —
# category names are per-account and not verified yet for OneBodyLDN.
INTERESTED_CATEGORY_NAME=Interested
AUTOREPLY_CATEGORY_NAME=Auto-Reply
MEETING_BOOKED_CATEGORY_NAME=Meeting-Booked

FOLLOWUP_WAIT_DAYS=3,4,6,8
MAX_FOLLOWUPS=4
REVIVE_AFTER_DAYS=60

# Offset from Mindaptive's (6) and AeroDefense's (7) scan hour so the three
# containers don't hammer Anthropic and Smartlead at the same minute.
DAILY_SCAN_HOUR_UTC=8
SCAN_INTERVAL_MINUTES=5

# --- Safety ------------------------------------------------------------------

# These campaigns are brand new — leave DRY_RUN on until Andrew has reviewed
# real drafts against real replies.
DRY_RUN=true
AUTO_SEND_FOLLOWUPS=false
AUTO_GENERATE_FOLLOWUPS=true

# Unused by OneBodyLDN (no Calendly booking flow — see the "Not filled in
# yet" note in clients/onebodyldn/knowledge/response-templates.md), kept only
# so config.py has a value.
CALENDLY_LINK=
REQUIRE_KNOWN_SENDER=false

# Every OneBodyLDN lead is a London-based professional. Skip per-lead
# language detection the same way AeroDefense does.
DETECT_LANGUAGE=false
